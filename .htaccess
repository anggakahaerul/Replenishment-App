<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ----------------------------------------------------------------------
    # 1. SECURITY & ACCESS RESTRICTIONS
    # ----------------------------------------------------------------------

    # Block access to hidden files and directories (starting with a dot)
    # Allows .well-known for ACME / Let's Encrypt SSL certificates
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Block direct HTTP access to framework directories in root
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|\.agents|\.claude|\.codex|node_modules)(/|$) - [F,L]

    # Block direct HTTP access to root configuration, package, and metadata files
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|boost\.json|opencode\.json|\.mcp\.json|AGENTS\.md|CLAUDE\.md|README\.md)$ - [F,L]

    # Block direct access to sensitive file extensions in root
    RewriteRule \.(env|log|sql|sqlite|bak|config|ini|sh|bat)$ - [F,L]

    # ----------------------------------------------------------------------
    # 2. HTTP HEADERS
    # ----------------------------------------------------------------------

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # ----------------------------------------------------------------------
    # 3. CANONICAL URL & REDIRECTS
    # ----------------------------------------------------------------------

    # Strip /public from URL if manually requested
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ %1 [L,R=301]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # ----------------------------------------------------------------------
    # 4. STATIC ASSET SERVING FROM /public FOLDER
    # ----------------------------------------------------------------------

    # Serve static asset directories from public/ (build, storage, assets)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(build|storage|assets)/(.*)$ public/$1/$2 [L]

    # Serve static files with extensions from public/ (favicon.ico, robots.txt, etc.)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([^/]+\.(css|js|jpg|jpeg|png|gif|ico|svg|webp|avif|woff|woff2|ttf|eot|otf|map|txt|pdf|csv|xlsx|json|xml))$ public/$1 [L]

    # ----------------------------------------------------------------------
    # 5. FRONT CONTROLLER ROUTING
    # ----------------------------------------------------------------------

    # Send all other requests to root index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# ----------------------------------------------------------------------
# 6. DIRECTORY LISTING & SENSITIVE FILE PROTECTION
# ----------------------------------------------------------------------
Options -Indexes

<FilesMatch "^(\.env|composer\.|package(-lock)?\.json|phpunit\.xml|artisan)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
